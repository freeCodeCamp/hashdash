---
const query = Astro.url.searchParams.get("q") ?? "";
---

<form action="/" method="get">
  <input
    type="text"
    name="q"
    value={query}
    placeholder="Search published posts..."
    aria-label="Search published posts"
    class="w-full border border-gray-600 bg-gray-800 px-3 py-2 text-sm text-gray-200 placeholder-gray-500 focus:border-transparent focus:ring-2 focus:ring-blue-500 focus:outline-none"
  />
</form>
