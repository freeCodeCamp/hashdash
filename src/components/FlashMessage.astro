---
interface Props {
  success?: string | null;
  error?: string | null;
}

const { success, error } = Astro.props;
---

{
  success && (
    <div class="mb-6 border border-green-800 bg-green-900/30 p-4 text-sm text-green-300">
      {success === "1" ? "Action completed successfully." : success}
    </div>
  )
}

{
  error && (
    <div class="mb-6 border border-red-800 bg-red-900/30 p-4 text-sm text-red-300">
      {error}
    </div>
  )
}
