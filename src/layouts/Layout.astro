---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import SearchBar from "../components/SearchBar.astro";
import FlashMessage from "../components/FlashMessage.astro";

interface Props {
  title?: string;
}

const { title = "hashdash" } = Astro.props;
const currentPath = Astro.url.pathname;
const success = Astro.url.searchParams.get("success");
const error = Astro.url.searchParams.get("error");

const navItems = [
  { href: "/", label: "Published" },
  { href: "/drafts", label: "Drafts" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      if (localStorage.getItem("theme") !== "light") {
        document.documentElement.classList.add("dark");
      }
      document.addEventListener("astro:before-swap", (e) => {
        const isDark = document.documentElement.classList.contains("dark");
        if (isDark) e.newDocument.documentElement.classList.add("dark");
      });
    </script>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <!-- Loading bar -->
    <div
      id="loading-bar"
      class="fixed top-0 left-0 z-50 h-0.5 bg-blue-500 transition-none"
      style="width:0%;opacity:0"
    >
    </div>
    <!-- Top Nav -->
    <header class="border-b border-gray-200 bg-white">
      <div class="mx-auto flex max-w-5xl items-center gap-6 px-6 py-3">
        <a href="/" class="shrink-0" aria-label="hashdash">
          <img
            src="/fcc_puck.svg"
            alt="freeCodeCamp"
            class="h-8 w-auto dark:invert"
          />
        </a>
        <nav class="flex shrink-0 items-center gap-1">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                data-astro-prefetch={
                  currentPath === item.href ? undefined : "load"
                }
                class:list={[
                  "px-3 py-1.5 text-base font-medium",
                  currentPath === item.href
                    ? "bg-gray-100 text-gray-900"
                    : "text-gray-600 hover:bg-gray-50 hover:text-gray-900",
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="ml-auto max-w-xl flex-1">
          <SearchBar />
        </div>
        <button
          id="theme-toggle"
          type="button"
          class="shrink-0 p-2 text-gray-500 hover:text-gray-900"
          aria-label="Toggle dark mode"
        >
          <svg
            id="theme-icon-sun"
            class="hidden h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"
            ></path>
          </svg>
          <svg
            id="theme-icon-moon"
            class="hidden h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
            ></path>
          </svg>
        </button>
      </div>
    </header>

    <!-- Main content -->
    <main class="mx-auto max-w-5xl px-6 py-8">
      {(success || error) && <FlashMessage success={success} error={error} />}
      <slot />
    </main>
    <script is:inline>
      function initThemeToggle() {
        const toggle = document.getElementById("theme-toggle");
        const sun = document.getElementById("theme-icon-sun");
        const moon = document.getElementById("theme-icon-moon");
        if (!toggle || !sun || !moon) return;

        function updateIcons() {
          const isDark = document.documentElement.classList.contains("dark");
          sun.classList.toggle("hidden", !isDark);
          moon.classList.toggle("hidden", isDark);
        }

        updateIcons();

        toggle.replaceWith(toggle.cloneNode(true));
        const freshToggle = document.getElementById("theme-toggle");
        freshToggle.addEventListener("click", () => {
          const isDark = document.documentElement.classList.toggle("dark");
          localStorage.setItem("theme", isDark ? "dark" : "light");
          updateIcons();
        });
      }

      initThemeToggle();
      document.addEventListener("astro:page-load", initThemeToggle);
    </script>
    <script is:inline>
      (function () {
        var bar = document.getElementById("loading-bar");
        var trickle;

        function start() {
          if (!bar) return;
          bar.style.transition = "none";
          bar.style.width = "0%";
          bar.style.opacity = "1";
          // Force reflow then animate
          void bar.offsetWidth;
          bar.style.transition = "width 0.6s cubic-bezier(0.4, 0, 0.2, 1)";
          bar.style.width = "30%";
          trickle = setTimeout(function () {
            bar.style.transition = "width 8s cubic-bezier(0.1, 0.05, 0, 1)";
            bar.style.width = "85%";
          }, 600);
        }

        function finish() {
          if (!bar) return;
          clearTimeout(trickle);
          bar.style.transition = "width 0.2s ease-out";
          bar.style.width = "100%";
          setTimeout(function () {
            bar.style.transition = "opacity 0.3s ease";
            bar.style.opacity = "0";
          }, 200);
        }

        document.addEventListener("astro:before-preparation", start);
        document.addEventListener("astro:page-load", finish);
      })();
    </script>
  </body>
</html>
