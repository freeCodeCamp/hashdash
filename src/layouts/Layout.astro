---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import FlashMessage from "../components/FlashMessage.astro";

interface Props {
  title?: string;
}

const { title = "hashdash" } = Astro.props;
const currentPath = Astro.url.pathname;
const success = Astro.url.searchParams.get("success");
const error = Astro.url.searchParams.get("error");

const navItems = [
  { href: "/", label: "Articles" },
  { href: "/submissions", label: "Submissions" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="16x16" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add("dark");
      document.addEventListener("astro:before-swap", function (e) {
        e.newDocument.documentElement.classList.add("dark");
      });
    </script>
  </head>
  <body class="min-h-screen bg-gray-950 text-gray-100">
    <!-- Loading bar -->
    <div
      id="loading-bar"
      class="fixed top-0 left-0 z-50 h-0.5 bg-blue-500 transition-none"
      style="width:0%;opacity:0"
    >
    </div>
    <!-- Top Nav -->
    <header class="border-b border-gray-700 bg-gray-900">
      <div class="mx-auto flex max-w-5xl items-center gap-6 px-6 py-3">
        <a href="/" class="shrink-0" aria-label="hashdash">
          <img
            src="/fcc_puck.svg"
            alt="freeCodeCamp"
            class="h-8 w-auto invert"
          />
        </a>
        <nav class="flex shrink-0 items-center gap-1">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                data-astro-prefetch={
                  currentPath === item.href ? undefined : "load"
                }
                class:list={[
                  "px-3 py-1.5 text-base font-medium",
                  currentPath === item.href
                    ? "bg-gray-800 text-gray-100"
                    : "text-gray-400 hover:bg-gray-800 hover:text-gray-200",
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <a
          href="/reindex"
          class:list={[
            "ml-auto flex items-center p-1.5",
            currentPath === "/reindex"
              ? "text-gray-100"
              : "text-gray-400 hover:text-gray-200",
          ]}
          aria-label="Settings"
          data-astro-prefetch={currentPath === "/reindex" ? undefined : "load"}
        >
          <svg
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"
            />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
            />
          </svg>
        </a>
      </div>
    </header>

    <!-- Main content -->
    <main class="mx-auto max-w-5xl px-6 py-8">
      {(success || error) && <FlashMessage success={success} error={error} />}
      <slot />
    </main>
    <script is:inline>
      (function () {
        var bar = document.getElementById("loading-bar");
        var trickle;

        function start() {
          if (!bar) return;
          bar.style.transition = "none";
          bar.style.width = "0%";
          bar.style.opacity = "1";
          // Force reflow then animate
          void bar.offsetWidth;
          bar.style.transition = "width 0.6s cubic-bezier(0.4, 0, 0.2, 1)";
          bar.style.width = "30%";
          trickle = setTimeout(function () {
            bar.style.transition = "width 8s cubic-bezier(0.1, 0.05, 0, 1)";
            bar.style.width = "85%";
          }, 600);
        }

        function finish() {
          if (!bar) return;
          clearTimeout(trickle);
          bar.style.transition = "width 0.2s ease-out";
          bar.style.width = "100%";
          setTimeout(function () {
            bar.style.transition = "opacity 0.3s ease";
            bar.style.opacity = "0";
          }, 200);
        }

        document.addEventListener("astro:before-preparation", start);
        document.addEventListener("astro:page-load", finish);
      })();
    </script>
  </body>
</html>
